{
  "dataset": {
    "name": "aptos2019_clean_binary_v1",
    "use_predefined_splits": true,
    "train_csv_path": "data/splits/aptos2019_clean_binary_v1/train.csv",
    "train_images_dir": ".",
    "valid_csv_path": "data/splits/aptos2019_clean_binary_v1/valid.csv",
    "valid_images_dir": ".",
    "test_csv_path": "data/splits/aptos2019_clean_binary_v1/test.csv",
    "test_images_dir": ".",
    "binary_classification": true,
    "image_size": 224,
    "preprocessing": {
      "enabled": false
    }
  },
  "training": {
    "model_name": "efficientnet_b0",
    "num_classes": 2,
    "pretrained": true,
    "seed": 42,
    "batch_size": 16,
    "num_epochs": 5,
    "learning_rate": 0.0003,
    "weight_decay": 0.0,
    "num_workers": 2,
    "monitor_metric": "f1",
    "loss": {
      "name": "cross_entropy"
    },
    "save_run_artifacts": true,
    "prevent_overwrite": true,
    "evaluate_test": false,
    "verify_clean_split": true
  },
  "paths": {
    "model_dir": "models/efficientnet_b0_clean_binary",
    "output_dir": "outputs/efficientnet_b0_clean_binary"
  }
}
